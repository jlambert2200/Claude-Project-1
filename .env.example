# Notification method: "imessage" or "email_sms"
NOTIFY_METHOD=imessage

# Your wife's phone number (with country code)
TO_PHONE_NUMBER=+1234567890

# How often to check for game results (in minutes)
CHECK_INTERVAL_MINUTES=15

# --- iMessage settings (macOS only) ---
# No extra config needed — just set NOTIFY_METHOD=imessage and TO_PHONE_NUMBER above.
# Requires running on a Mac with Messages.app signed in to iMessage.

# --- Email-to-SMS settings (any platform) ---
# Set NOTIFY_METHOD=email_sms and fill in the values below.
# CARRIER options: att, tmobile, verizon, sprint, uscellular, boost, cricket, metro, googlefi, mint
# CARRIER=verizon
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password
